# Configuration de la VM nexora-creative (copiée dans /etc/nexora/creative.env, root:nexora, 0640). Aucun secret ici.
NODE_ENV=production
OPENFIELD_HOST=127.0.0.1
OPENFIELD_PORT=3161
OPENFIELD_DATA=/srv/creative/data
OPENFIELD_OUTPUT=/srv/creative/data/rendus
# Moteur principal : GB10 (pc6), par tunnel SSH ; comfy-api-proxy est lancé par le serveur
COMFY_URL=http://127.0.0.1:37188
COMFY_BASE_URL=http://127.0.0.1:37189
COMFY_PROXY_BIN=/srv/creative/engine/proxy-venv/bin/comfy-api-proxy
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
NEXORA_TERRITOIRE=CA
NEXORA_MOTEUR_NOM=DGX Spark GB10
NEXORA_MOTEUR_RECETTES=qwen21,qwen,flux2,music3,objet-apercu,objet-qualite
# Second moteur : RTX 5090 (pc1), par tunnel SSH
NEXORA_MOTEURS_GPU=[{"id":"rtx5090","nom":"RTX 5090 (pc1)","comfyUrl":"http://127.0.0.1:37288","baseUrl":"http://127.0.0.1:37289","recettes":["h3-fast","h3-max"]}]
# Secondes par recette du moteur principal (médianes mesurées, recherche/21) : le routage minimise l'heure de fin estimée
NEXORA_MOTEUR_SECONDES={"objet-apercu":46,"objet-qualite":189}
# Relief (3D) : moteurs Turing de pc5 (VM nexora-gpu, LAN, sans tunnel), BROUILLONS et PLUSIEURS VUES seulement ; « qualité » reste sur la GB10
# (531 s sur une 2070 SUPER contre 162 à 189 s). Un brouillon déborde sur eux quand la file de la GB10 dépasse 3 tâches. À ajouter au JSON ci-dessus pour activer ; voir docs/gpu-pc5.md
# NEXORA_MOTEURS_GPU=[{"id":"rtx5090","nom":"RTX 5090 (pc1)","comfyUrl":"http://127.0.0.1:37288","baseUrl":"http://127.0.0.1:37289","recettes":["h3-fast","h3-max"]},{"id":"turing-2080s","nom":"RTX 2080 SUPER (pc5)","comfyUrl":"http://192.168.1.124:8188","baseUrl":"http://127.0.0.1:37388","recettes":["objet-apercu","objet-multivue"],"secondes":{"objet-apercu":190,"objet-multivue":190}},{"id":"turing-2070s","nom":"RTX 2070 SUPER (pc5)","comfyUrl":"http://192.168.1.124:8189","baseUrl":"http://127.0.0.1:37389","recettes":["objet-apercu","objet-multivue"],"secondes":{"objet-apercu":220,"objet-multivue":220}}]
# Juge de Relief (note sur quatre côtés, modèle vision ; jetons mesurés et facturés) : par défaut qwen/qwen3.8-27b ; google/gemini-4-argon (Flex) possible
# NEXORA_LLM_MODELE_JUGE3D=qwen/qwen3.8-27b
NEXORA_H3_MAX_CHECKPOINT=10Eros_Max_h3_8stepTURBO_beta7_SingularityV2_ref2va_int8HQ.safetensors
NEXORA_H3_MAX_ETAPES=8
NEXORA_TRANSCRIPTION_PYTHON=/srv/creative/engine/transcription-venv/bin/python
# Assistant et réécritures : OpenRouter (la clé est posée à la main sur la VM, jamais dans le dépôt)
NEXORA_LLM_BASE_URL=https://openrouter.ai/api/v1
NEXORA_LLM_MODELE=z-ai/glm-5.3
NEXORA_LLM_CLE=
# Juge visuel (2 prises par plan, le meilleur est gardé) : modèle vision du rôle « juge » (c'est aussi le défaut du code ; la ligne ci-dessous le rend explicite)
NEXORA_LLM_MODELE_JUGE=qwen/qwen3.8-27b
# Agent Producteur : plafond de dépense par production (crédits avec le portail, minutes de calcul sinon)
NEXORA_PRODUCTEUR_PLAFOND_CREDITS=400
NEXORA_PRODUCTEUR_PLAFOND_MINUTES=30
